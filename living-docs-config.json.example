{
  "schema_version": 1,
  "base_url": "http://localhost:3000",
  "workers": 1,
  "reuse_session": true,
  "browser": {
    "binary_path": null,
    "driver_path": null,
    "headless": true,
    "window_size": [1920, 1080],
    "offline": false
  },
  "security": {
    "allowed_origins": ["http://localhost:3000"],
    "output_root": "."
  },
  "flows": {
    "login": [
      {"action": "goto", "url": "/login"},
      {"action": "type", "selector": "#user", "text": "${ENV:LIVING_DOCS_USER}"},
      {"action": "type", "selector": "#pass", "text": "${ENV:LIVING_DOCS_PASSWORD}"},
      {"action": "click", "selector": "#submit"},
      {"action": "wait_for_selector", "selector": "#dashboard"}
    ]
  },
  "mappings": [
    {
      "description": "Custom component previews",
      "pattern": "src/components/(.*)\\.tsx",
      "urls": ["/preview/{1}"]
    }
  ]
}
