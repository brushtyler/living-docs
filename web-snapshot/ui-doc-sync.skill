{
  "name": "ui-doc-sync",
  "description": "Synchronize documentation screenshots and UI text by capturing the latest state from a live website.",
  "version": "1.0.0",
  "actions": [
    {
      "name": "sync documentation with ui",
      "description": "Scans the project for 'snapshot-recipe' blocks and updates all screenshots. Also extracts UI text to help identify where documentation needs updates. (Trigger: 'regen user documentation')",
      "steps": [
        {
          "command": "web-snapshot/venv/bin/python3 web-snapshot/skills/ui-doc-sync/scripts/updater.py --bot web-snapshot/browser_bot.py",
          "description": "Running the UI-to-Doc synchronization script."
        }
      ]
    }
  ]
}
